{
  "name": "questboard",
  "version": "1.0.0",
  "description": "Questboard - coordinamento dello sviluppo di videogiochi con sincronizzazione bidirezionale su un forum Discord",
  "author": "rewi.dev",
  "license": "MIT",
  "private": true,
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "nodemon --watch src --watch views --watch migrations --ext js,json,ejs,sql --signal SIGTERM --delay 300ms src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed-demo": "node scripts/seed-demo.js",
    "test": "node scripts/test.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  }
}
