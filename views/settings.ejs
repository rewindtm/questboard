<%- include('partials/head') %>
<%- include('partials/breadcrumb', { crumb: 'Impostazioni' }) %>
<header>
  <h1 class="text-3xl font-bold tracking-tight text-white">Impostazioni</h1>
  <p class="mt-2 text-sm text-muted">Dati del progetto e, se vuoi, il collegamento a un forum Discord. Il progetto funziona anche senza.</p>
</header>

<form id="settingsForm" class="mt-8 max-w-3xl space-y-6" data-project-id="<%= project.id %>">
  <section class="rounded-xl border border-edge bg-panel p-6">
    <h2 class="text-sm font-semibold text-white">Progetto</h2>
    <label for="s-name" class="mb-2 mt-4 block text-xs text-muted">Nome</label>
    <input id="s-name" name="name" required maxlength="80" value="<%= settings.name %>" class="w-full rounded-lg border border-edge bg-canvas p-3 text-sm">
    <label for="s-desc" class="mb-2 mt-4 block text-xs text-muted">Descrizione</label>
    <input id="s-desc" name="description" maxlength="300" value="<%= settings.description %>" class="w-full rounded-lg border border-edge bg-canvas p-3 text-sm">
    <label for="s-cat" class="mb-2 mt-4 block text-xs text-muted">Categorie (una per riga)</label>
    <textarea id="s-cat" name="categories" rows="5" class="w-full rounded-lg border border-edge bg-canvas p-3 text-sm"><%= settings.categories.join('\n') %></textarea>
  </section>

  <section class="rounded-xl border border-edge bg-panel p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-sm font-semibold text-white">Forum Discord</h2>
      <% if (botConfigured) { %>
      <span class="rounded-md bg-emerald-400/10 px-2 py-1 text-[10px] text-emerald-300">Bot configurato</span>
      <% } else { %>
      <span class="rounded-md bg-amber-400/10 px-2 py-1 text-[10px] text-amber-300">Bot non configurato (DISCORD_BOT_TOKEN assente)</span>
      <% } %>
    </div>
    <p class="mt-2 text-xs text-muted">Lascia vuoti i due ID per usare Questboard senza Discord. Con i campi compilati puoi pubblicare i task nel forum, dal dettaglio del task.</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <div><label for="s-guild" class="mb-2 block text-xs text-muted">ID server</label>
        <input id="s-guild" name="discord_guild_id" inputmode="numeric" maxlength="25" value="<%= settings.discord_guild_id %>" class="w-full rounded-lg border border-edge bg-canvas p-3 text-sm"></div>
      <div><label for="s-forum" class="mb-2 block text-xs text-muted">ID canale forum</label>
        <input id="s-forum" name="discord_forum_id" inputmode="numeric" maxlength="25" value="<%= settings.discord_forum_id %>" class="w-full rounded-lg border border-edge bg-canvas p-3 text-sm"></div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="button" id="checkDiscord" class="rounded-lg border border-edge px-4 py-2 text-xs font-semibold hover:bg-white/5" <%= botConfigured ? '' : 'disabled' %>>Verifica forum e carica i tag</button>
      <span id="checkResult" class="text-xs" role="status"></span>
    </div>

    <h3 class="mt-6 text-xs font-semibold text-white">Mappatura dei tag</h3>
    <p class="mt-1 text-xs text-muted">Il bot applica un tag di stato e uno di priorità a ogni post (massimo 2 dei 5 tag consentiti dal forum). Prima verifica il forum per scegliere dall'elenco.</p>
    <div class="mt-3 grid gap-3 sm:grid-cols-2" id="tagMap"
         data-map="<%= JSON.stringify(settings.discord_tag_map) %>"
         data-status="<%= JSON.stringify(labels.STATUSES.map(function (s) { return [s, labels.STATUS_LABELS[s]]; })) %>"
         data-priority="<%= JSON.stringify(labels.PRIORITIES.map(function (s) { return [s, labels.PRIORITY_LABELS[s]]; })) %>"></div>
  </section>

  <p class="form-error text-sm text-red-300" id="settingsError" role="alert"></p>
  <div class="flex justify-end"><button class="rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white hover:bg-orange-500">Salva impostazioni</button></div>
</form>
<%- include('partials/foot', { scripts: ['/static/js/settings.js'] }) %>
