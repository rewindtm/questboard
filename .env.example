NODE_ENV=development
PORT=3000

# PostgreSQL (unica fonte dei dati; contiene anche sessioni e outbox Discord)
DATABASE_URL=postgres://questboard:questboard@localhost:5432/questboard

# Segreto per firmare i cookie di sessione (almeno 32 caratteri casuali):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# URL pubblico dell'app (link nei post Discord; se https i cookie diventano "secure")
APP_BASE_URL=http://localhost:3000
# 1 se l'app e dietro un reverse proxy HTTPS (nginx, Cloudflare Tunnel, ...)
# Lascia vuoto: attivo automaticamente se APP_BASE_URL è https (dietro reverse proxy). Metti 0 per disattivarlo.
TRUST_PROXY=

# Discord OAuth2 (login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Bot Discord. Se vuoto il pannello parte e l'integrazione risulta "non configurata".
DISCORD_BOT_TOKEN=

# Discord user ID del primo amministratore (Game Director). E l'unico modo per
# creare il primo progetto: nessun visitatore diventa admin da solo.
BOOTSTRAP_ADMIN_DISCORD_ID=

# --- Uso SENZA Discord (opzionale) ---
# Con ENABLE_LOCAL_AUTH=1 compare anche il login con utente e password. Gli account sono
# creati solo dagli amministratori; il primo admin e definito qui (password min. 12 caratteri,
# salvata come hash scrypt). In questa modalita DISCORD_* e DISCORD_BOT_TOKEN possono restare vuoti.
ENABLE_LOCAL_AUTH=0
BOOTSTRAP_ADMIN_LOGIN=
BOOTSTRAP_ADMIN_PASSWORD=
